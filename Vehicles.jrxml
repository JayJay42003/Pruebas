	<queryString language="SQL">
		<![CDATA[SELECT 'car' AS vehicleType,
	c."IDVEHICLE",
	c."LICENSEPLATE",
	c."BRAND",
	c."MODEL",
	c."YEARCREATED",
	c."TYPEFUEL",
	c."DOORSNUM",
	co."IDCONCESSIONAIRE",
	co."NAME" AS concessionaire_name,
	co."NUMVEHICLES"
FROM "CAR" c
	JOIN "CONCESSIONAIRE" co ON 
	 c."IDCONCESSIONAIRE" = co."IDCONCESSIONAIRE" 
UNION ALL 
SELECT 'motorcycle' AS vehicleType,
	m."IDVEHICLE",
	m."LICENSEPLATE",
	m."BRAND",
	m."MODEL",
	m."YEARCREATED",
	m."TYPEFUEL",
	m."CYLINDERCAPACITY",
	co."IDCONCESSIONAIRE",
	co."NAME" AS concessionaire_name,
	co."NUMVEHICLES"
FROM "MOTORCYCLE" m
	JOIN "CONCESSIONAIRE" co ON 
	 m."IDCONCESSIONAIRE" = co."IDCONCESSIONAIRE"]]>
	</queryString>
